# 复制为 .env 并填入真实值（.env 不入库）
# 读写账号：仅 mock 数据生成器使用（data/mock_gen.py）
PG_DSN=postgresql://chatbi_app:<password>@127.0.0.1:5432/chatbi
# 只读账号：运行时唯一连接方式（工具层 run_query）
PG_DSN_RO=postgresql://chatbi_ro:<password>@127.0.0.1:5432/chatbi
# 智谱开放平台（OpenAI 兼容端点：https://open.bigmodel.cn/api/coding/paas/v4/）
ZHIPU_API_KEY=<key>
CHATBI_MODEL=glm-5.3
